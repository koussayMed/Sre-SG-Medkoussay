# Rendu au démarrage par l'entrypoint de l'image nginx (envsubst) : ${BACKEND_URL} est remplacé.
# Ce fichier est inclus dans le bloc http {} de nginx.

# Corrélation : on garde l'X-Request-ID reçu, sinon nginx en génère un ($request_id)
map $http_x_request_id $req_id {
    default $http_x_request_id;
    ""      $request_id;
}

# Schéma d'origine : derrière l'ingress Container Apps, nginx reçoit du HTTP
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Logs d'accès en JSON sur stdout (collectés vers Log Analytics), même request_id que le backend
log_format json escape=json
    '{"timestamp":"$time_iso8601","level":"INFO","service":"frontend",'
    '"message":"request completed","request_id":"$req_id","method":"$request_method",'
    '"path":"$uri","status":$status,"duration_s":$request_time,'
    '"upstream_s":"$upstream_response_time","bytes":$body_bytes_sent,'
    '"client_ip":"$remote_addr","user_agent":"$http_user_agent"}';

server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;
    access_log /dev/stdout json;

    # En-têtes de sécurité, posés ici une seule fois pour tout le site
    add_header X-Request-ID $req_id always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'none'" always;

    # Sonde du front lui-même : ne dépend pas du backend
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # API : relayée au backend, qui n'est pas exposé publiquement
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Request-ID $req_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_ssl_server_name on;          # SNI si le backend est joint en HTTPS (Container Apps interne)
        proxy_hide_header X-Request-ID;    # évite le doublon avec celui ajouté par add_header

        proxy_connect_timeout 2s;
        proxy_read_timeout 15s;            # > timeouts du backend vers l'API météo (retries compris)

        # Backend injoignable ou trop lent : réponse JSON claire au lieu d'une page d'erreur nginx
        error_page 502 504 = @backend_down;
    }

    location @backend_down {
        default_type application/json;
        add_header X-Request-ID $req_id always;
        return 503 '{"error":"backend_unavailable","message":"Backend indisponible","request_id":"$req_id"}';
    }

    location = /favicon.ico {
        access_log off;
        return 204;
    }

    # Revalidation à chaque chargement (ETag : réponse 304 si rien n'a changé) :
    # après un déploiement, aucun visiteur ne garde l'ancien JavaScript
    location /static/ {
        expires -1;
    }

    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
