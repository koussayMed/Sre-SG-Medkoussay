# Copier en .env (ignoré par git) et changer le mot de passe. Ne jamais commiter .env.
POSTGRES_DB=meteo
POSTGRES_USER=meteo
# Lettres et chiffres uniquement (il est inséré tel quel dans l'URL de connexion du backend)
POSTGRES_PASSWORD=change-me

# Port de la base sur le poste (le backend, lui, passe par le réseau Docker interne).
# 55432 plutôt que 5432 : évite un Postgres local ou une plage de ports réservée par Windows.
DB_HOST_PORT=55432

LOG_LEVEL=INFO
WEATHER_CACHE_TTL_S=600
